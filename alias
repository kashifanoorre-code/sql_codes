SELECT Transaction1.invoiceno, Transaction1.Cid, Client1.name, Client1.City FROM Transaction1, Client1 
WHERE Transaction1.Cid = Client1.Cid;

SELECT Transaction1.invoiceno, Transaction1.Pid, Stocks1.Item, Stocks1.Rate 
FROM Transaction1, Stocks1 WHERE Stocks1.Pid = Transaction1.Pid;

SELECT Transaction1.invoiceno, Transaction1.Pid, Stocks1.Item, Stocks1.Rate,
Stocks1.Rate*Transaction1.qty AS amount FROM Transaction1, Stocks1 WHERE Stocks1.Pid = Transaction1.Pid;

SELECT Transaction1.invoiceno,Transaction1.Cid,
Client1.name, Transaction1.Pid, Stocks1.Item, Stocks1.Rate,
Stocks1.Rate*Transaction1.qty AS amount FROM 
Transaction1, Stocks1, Client1 WHERE Stocks1.Pid = Transaction1.Pid AND Client1.Cid = Transaction1.Cid;

SELECT T.invoiceno, T.Cid, C.Name, T.Pid, G.Item, G.Rate, 
G.Rate*T.qty AS Amount FROM 
Transaction1 T, Stocks1 G, Client1 C WHERE 
G.Pid = T.Pid AND C.Cid = T.Cid;
