CREATE TABLE employee(
  empid int primary key,
  name varchar(9) not null,
  age int,
  location varchar(8) not null,
  deptid int,
  salary int,
  CHECK (location IN ('kol 12', 'kol 14', 'kol 16', 'kol 18', 'kol 20')),
  CHECK (deptid IN(10,12,14,16,18,20))
);

