-- Find departments having at least two employees.
SELECT COUNT(*) AS number_emp, DepartmentID FROM 
Employees GROUP BY DepartmentID HAVING COUNT(*) >= 2;

-- Display employee names together with their department names.
SELECT e.FirstName, e.LastName, d.DepartmentName 
FROM Employees e JOIN Departments d ON e.DepartmentID = d.DepartmentID;

-- Show all departments, including departments that currently have no employees.
SELECT e.FirstName, e.LastName, d.DepartmentName FROM Departments d
LEFT JOIN Employees e ON e.DepartmentID = d.DepartmentID;

-- Find departments whose average salary is greater than 55,000.
SELECT DepartmentID, AVG(Salary) FROM Employees
 GROUP BY DepartmentID HAVING AVG(SALARY)>55000;

-- Display the highest salary in each department.
SELECT DepartmentID, MAX(SALARY) AS Max_salary FROM Employees GROUP BY DepartmentID;

-- Combine JOIN, GROUP BY and HAVING to show departments with total salary above 100,000.
SELECT d.DepartmentName, SUM(e.Salary)
FROM Employees e JOIN Departments d ON e.DepartmentID= d.DepartmentID
 GROUP BY d.DepartmentName HAVING SUM(e.Salary)>100000;
