--returns every row from left table and adds matching data
SELECT e.FirstName, d.DepartmentName FROM Employees e
LEFT JOIN Departments d ON e.DepartmentID = d.DepartmentID;

--returns every row from right table and adds matching data
SELECT e.FirstName, d.DepartmentID FROM Employees e
RIGHT JOIN Departments d ON e.DepartmentID = d.DepartmentID;

--full outer join keeps rows from both the tables and matches where necessary
SELECT e.FirstName, d.DepartmentID FROM Employees e
FULL OUTER JOIN Departments d ON e.DepartmentID = d.DepartmentID;

