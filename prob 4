SELECT * FROM employee ORDER BY location ASC;

SELECT location, SUM(salary) FROM employee GROUP BY location;

SELECT deptid, SUM(salary) FROM employee GROUP BY deptid;

SELECT COUNT(*) AS total_employees, SUM(salary) AS total_salary FROM employee;

SELECT COUNT(*) FROM employee WHERE age>=40 AND age<=60 ;

SELECT location, COUNT(*) AS total_number FROM employee GROUP BY location;

SELECT deptid, COUNT(*) AS total_number FROM employee GROUP BY deptid;

SELECT MAX(salary), MIN(salary) FROM employee;

SELECT 
  (SELECT MAX(salary) FROM employee WHERE salary < (SELECT MAX(salary) FROM employee)) AS second_highest,
  (SELECT MIN(salary) FROM employee WHERE salary > (SELECT MIN(salary) FROM employee)) AS second_lowest;

SELECT AVG(salary) AS AVG_SALARY FROM employee;

SELECT name FROM employee WHERE age>50 AND AGE<60;

SELECT MAX(age) AS max_age, MIN(age) AS min_age FROM employee;

SELECT COUNT(*) AS total_employees 
FROM employee 
WHERE salary > (SELECT AVG(salary) FROM employee);

